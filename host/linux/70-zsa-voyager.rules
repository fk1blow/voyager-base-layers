# ZSA Voyager (and other ZSA boards): raw HID access + switch to the Omarchy
# base layer on plug-in. Install to /etc/udev/rules.d/ (host/install.sh does it).

# Let the logged-in user open the raw HID interface.
# ATTRS walks parent devices, so this works through a USB hub or dock.
KERNEL=="hidraw*", ATTRS{idVendor}=="3297", TAG+="uaccess"

# Run voyager-omarchy.service when the board appears.
# TAG+="systemd" is required: udev properties are ignored on untagged devices
# (systemd.device(5)). Without it SYSTEMD_USER_WANTS silently does nothing.
# The board exposes several hidraw nodes, so this may fire more than once --
# harmless, the unit is a oneshot and switching is idempotent.
ACTION=="add", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3297", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="voyager-omarchy.service"
