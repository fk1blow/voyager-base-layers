<?xml version="1.0" encoding="UTF-8"?>
<!--
  OPTIONAL, and only useful on STOCK Oryx firmware.

  With the custom firmware from this repo the status LEDs are already dark on
  both base layers, and the board goes quiet after every base switch, so this
  watcher would stop receiving layer events and do nothing.

  host/install.sh installs it only with --leds, and expands $HOME first --
  launchd does not expand environment variables in these paths.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.voyager.leds</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/voyager-layer</string>
        <string>leds</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/voyager-leds.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/voyager-leds.log</string>
</dict>
</plist>
